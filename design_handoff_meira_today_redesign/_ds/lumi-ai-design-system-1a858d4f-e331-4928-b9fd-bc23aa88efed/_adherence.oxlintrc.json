{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/feedback/**",
              "components/navigation/**",
              "components/overlays/**",
              "components/schedule/**",
              "components/tasks/**",
              "meira-demo.js",
              "ui_kits/lumi-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fredoka|Nunito|Fraunces))/i]",
        "message": "Font not provided by the design system. Available: Fredoka, Nunito, Fraunces."
      },
      {
        "selector": "JSXOpeningElement[name.name='AttentionBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|action|onAction|onDismiss|style|key|ref|className|style|children)$/]",
        "message": "<AttentionBanner> doesn't accept that prop. Declared props: tone, children, action, onAction, onDismiss, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AttentionBanner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:offline|clash|note|card)$/]",
        "message": "<AttentionBanner> tone must be one of 'offline' | 'clash' | 'note' | 'card'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:initial|size|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: initial, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|block|disabled|icon|onClick|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, tone, size, block, disabled, icon, onClick, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|gradient|ghost|dark|quiet|danger)$/]",
        "message": "<Button> tone must be one of 'primary' | 'gradient' | 'ghost' | 'dark' | 'quiet' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|bordered|padding|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, tone, bordered, padding, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:card|soft|accent|gold|gradient)$/]",
        "message": "<Card> tone must be one of 'card' | 'soft' | 'accent' | 'gold' | 'gradient'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:category|size|iconOnly|style|key|ref|className|style|children)$/]",
        "message": "<CategoryBadge> doesn't accept that prop. Declared props: category, size, iconOnly, style."
